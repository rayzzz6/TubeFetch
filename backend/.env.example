# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,https://tubefetch.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
DOWNLOAD_RATE_LIMIT_MAX=5

# Cache
ANALYZE_CACHE_TTL_SECONDS=300

# --------------------------------------------------------------------------
# REPLACE-ME: when swapping the mock service for a real, licensed media
# source, its credentials go here — never hardcode them in source files.
# The app never reads secrets on the client; all provider calls happen
# server-side inside services/*.service.ts.
# MEDIA_PROVIDER_API_KEY=
# MEDIA_PROVIDER_BASE_URL=
# --------------------------------------------------------------------------
